{
  "name": "@spectershell/dsh-grid-panel",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Responsive grid layout for DeepSeek Harness global sidebar panels",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": {
    "name": "SpecterShell",
    "url": "https://github.com/SpecterShell"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpecterShell/dsh-grid-panel.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=22.23.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "check": "pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "tsdown": "^0.23.7",
    "typescript": "~5.9.3"
  }
}
